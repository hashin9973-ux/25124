{
  "schema_version": 1,
  "note": "Character Studio starts empty and does not prescribe a species, anatomy, rig or model. The mesh viewport renders the active authored mesh and configured construction-plane grid, supports vertex/edge/face ray picking, vertex placement, edge/face creation, topology deletion with dependent-face cleanup, grid-step translation, per-document bounded undo/redo, document cycling, and version-checked persistence with previous-generation recovery. Freeform translate/rotate/scale gizmos and modifier evaluation are not yet exposed in the viewport.",
  "implemented_foundation": [
    "world_browser",
    "world_local_data_loading",
    "world_local_asset_namespace",
    "species_base_catalog",
    "action_trigger_contract",
    "physics_world_viewport",
    "articulated_ragdoll_preview",
    "mesh_document_persistence",
    "mesh_topology_validation",
    "mesh_vertex_translation",
    "mesh_face_extrusion",
    "construction_plane_grid"
  ],
  "tool_groups": [
    {
      "id": "mesh_edit",
      "name": "Mesh Editing",
      "status": "viewport_editing_foundation",
      "selection_modes": [
        "vertex",
        "edge",
        "face"
      ],
      "operators": [
        "move",
        "rotate",
        "scale",
        "extrude",
        "inset",
        "bevel",
        "loop_cut",
        "bridge",
        "subdivide",
        "merge",
        "dissolve",
        "recalculate_normals",
        "separate",
        "join"
      ],
      "implemented_operators": [
        "create_mesh_document",
        "add_vertex",
        "add_edge",
        "create_face",
        "translate_vertices",
        "extrude_face",
        "viewport_vertex_selection",
        "viewport_edge_selection",
        "viewport_face_selection",
        "construction_plane_vertex_placement",
        "construction_plane_grid",
        "version_checked_mesh_save",
        "previous_generation_recovery",
        "delete_elements",
        "viewport_delete_selection",
        "viewport_grid_step_translation",
        "viewport_undo_redo"
      ]
    },
    {
