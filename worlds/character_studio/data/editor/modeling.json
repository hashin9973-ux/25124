{
  "schema_version": 1,
  "coordinate_system": {
    "handedness": "right",
    "up_axis": "Y",
    "forward_axis": "-Z",
    "units": "meters"
  },
  "topology": {
    "editable_elements": [
      "vertex",
      "edge",
      "face"
    ],
    "normal_policy": "recompute_on_topology_change",
    "runtime_core": {
      "document": "world_owned_json_mesh_document",
      "elements": [
        "vertex",
        "edge",
        "face"
      ],
      "face_boundary": "explicit_ordered_edge_loop",
      "uvs": "per_face_corner",
      "normals": "derived_from_face_loop"
    }
  },
  "operators": {
    "transform": {
      "translate": true,
      "rotate": true,
      "scale": true,
      "proportional_edit": true
    },
    "topology": [
      "extrude",
      "inset",
      "bevel",
      "loop_cut",
      "bridge",
      "subdivide",
      "merge",
      "dissolve",
      "separate",
      "join",
      "recalculate_normals"
    ],
    "modifiers": [
      "mirror",
      "array",
      "subdivision_surface",
      "solidify",
      "decimate",
      "boolean"
    ],
    "implemented": [
      "create_empty_mesh_document",
      "add_vertex",
      "add_edge",
      "create_face",
      "translate_vertices",
      "extrude_face",
      "construction_plane_grid",
      "delete_elements",
      "viewport_grid_step_translation"
    ]
  },
  "symmetry": {
    "axes": [
      "x",
      "y",
      "z"
    ],
    "default_axis": "x"
  },
  "selection": {
    "modes": [
      "vertex",
      "edge",
      "face",
      "object"
    ],
    "supports_hierarchy": true
  },
  "construction_plane": {
    "origin_m": [
      0,
      0,
      0
    ],
    "normal_world": [
      0,
      1,
      0
    ],
    "grid_spacing_m": 0.25,
    "grid_extent_m": 5
  }
}
